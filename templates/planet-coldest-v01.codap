097SGpe","description":"What % of previous draws were different from this word?","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":false,"renameable":true,"deleteable":true,"formula":"if(TotalBefore > 0, round(100 * DifferentBefore / TotalBefore, 0), \"\")","guid":3101,"id":3101,"precision":2,"unit":null},{"name":"DrawNumber","type":"numeric","title":"DrawNumber","cid":"id:UT0luBkrQFyZKpnz","description":"Sequential draw number","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":true,"formula":"prev(DrawNumber, 0) + 1","guid":3102,"id":3102,"precision":2,"unit":null},{"name":"TotalBefore","type":"numeric","title":"TotalBefore","cid":"id:U8lm0EtXZBtKqDhz","description":"Total draws before this one","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":true,"formula":"DrawNumber - 1","guid":3103,"id":3103,"precision":2,"unit":null},{"name":"Count_1","type":"numeric","title":"Count 1","cid":"id:_P_1kt1Q3t5QIkFA","description":"Running count of \"Uranus\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":true,"formula":"prev(Count_1, 0) + if(Word = \"Uranus\", 1, 0)","guid":3104,"id":3104,"precision":2,"unit":null},{"name":"Count_2","type":"numeric","title":"Count 2","cid":"id:Mmv5jSYqO2DQq3R6","description":"Running count of \"Neptune\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":true,"formula":"prev(Count_2, 0) + if(Word = \"Neptune\", 1, 0)","guid":3105,"id":3105,"precision":2,"unit":null},{"name":"Count_3","type":"numeric","title":"Count 3","cid":"id:Bpz5WFyxd9JeHDUy","description":"Running count of \"Saturn\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":true,"formula":"prev(Count_3, 0) + if(Word = \"Saturn\", 1, 0)","guid":3106,"id":3106,"precision":2,"unit":null},{"name":"Count_4","type":"numeric","title":"C