"id:2VVNGmf77hy_2ZVA","description":"Running % of draws that were \"Neptune\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":false,"renameable":true,"deleteable":true,"formula":"if(DrawNumber > 0, round(100 * Count_2 / DrawNumber, 0), \"\")","guid":3094,"id":3094,"precision":2,"unit":null},{"name":"Pct_Saturn","type":"numeric","title":"% Saturn","cid":"id:9FKn2zhuuMAvWX_g","description":"Running % of draws that were \"Saturn\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":false,"renameable":true,"deleteable":true,"formula":"if(DrawNumber > 0, round(100 * Count_3 / DrawNumber, 0), \"\")","guid":3095,"id":3095,"precision":2,"unit":null},{"name":"Pct_Pluto","type":"numeric","title":"% Pluto","cid":"id:w1Tbio46YDNnerK3","description":"Running % of draws that were \"Pluto\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":false,"renameable":true,"deleteable":true,"formula":"if(DrawNumber > 0, round(100 * Count_4 / DrawNumber, 0), \"\")","guid":3096,"id":3096,"precision":2,"unit":null},{"name":"Pct_Mercury","type":"numeric","title":"% Mercury","cid":"id:h5R7x0vxbJ1YFOay","description":"Running % of draws that were \"Mercury\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":false,"renameable":true,"deleteable":true,"formula":"if(DrawNumber > 0, round(100 * Count_5 / DrawNumber, 0), \"\")","guid":3097,"id":3097,"precision":2,"unit":null},{"name":"Pct_Venus","type":"numeric","title":"% Venus","cid":"id:61ukPIB8PiVUaD1b","description":"Running % of draws that were \"Venus\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":false,"renameable":true,"deleteable":true,"formula":"if(DrawNumber > 0, round(100 * Count_6 / DrawNumber, 0), \"\")","guid":3098,"id":3098,"precision":2,"unit":null},{"name":"Pct_Mars","type":"numeric","title":"% Mars","cid":"id:S8J8bpucUZ6PnKS7","description":"Running % of draws that were \"Mars\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":false,"renameable":true,"deleteable":true,"formula":"if(DrawNumber > 0, round(100 * Count_7 / DrawNumber, 0), \"\")","guid":3099,"id":3099,"precision":2,"unit":null},{"name":"Pct_Jupiter","type":"numeric","title":"% Jupiter","cid":"id:6zWOvt9DOVJtnMdn","description":"Running % of draws that were \"Jupiter\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":false,"renameable":true,"deleteable":true,"formula":"if(DrawNumber > 0, round(100 * Count_8 / DrawNumber, 0), \"\")","guid":3100,"id":3100,"precision":2,"unit":null},{"name":"Differentness","type":"numeric","title":"Differentness (%)","cid":"id:40TktgBWL097SGpe","description":"What % of previous draws were different from this word?","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":false,"renameable":true,"deleteable":true,"formula":"if(TotalBefore > 0, round(100 * DifferentBefore / TotalBefore, 0), \"\")","guid":3101,"id":3101,"precision":2,"unit":null},{"name":"DrawNumber","type":"numeric","title":"DrawNumber","cid":"id:UT0luBkrQFyZKpnz","description":"Sequential draw number","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":true,"formula":"prev(DrawNumber, 0) + 1","guid":3102,"id":3102,"precision":2,"unit":null},{"name":"TotalBefore","type":"numeric","title":"TotalBefore","cid":"id:U8lm0EtXZBtKqDhz","description":"Total draws before this one","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":true,"formula":"DrawNumber - 1","guid":3103,"id":3103,"precision":2,"unit":null},{"name":"Count_1","type":"numeric","title":"Count 1","cid":"id:_P_1kt1Q3t5QIkFA","description":"Running count of \"Uranus\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":true,"formula":"prev(Count_1, 0) + if(Word = \"Uranus\", 1, 0)","guid":3104,"id":3104,"precision":2,"unit":null},{"name":"Count_2","type":"numeric","title":"Count 2","cid":"id:Mmv5jSYqO2DQq3R6","description":"Running count of \"Neptune\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":true,"formula":"prev(Count_2, 0) + if(Word = \"Neptune\", 1, 0)","guid":3105,"id":3105,"precision":2,"unit":null},{"name":"Count_3","type":"numeric","title":"Count 3","cid":"id:Bpz5WFyxd9JeHDUy","description":"Running count of \"Saturn\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":true,"formula":"prev(Count_3, 0) + if(Word = \"Saturn\", 1, 0)","guid":3106,"id":3106,"precision":2,"unit":null},{"name":"Count_4","type":"numeric","title":"Count 4","cid":"id:p36ux44KPsnG2RW2","description":"Running count of \"Pluto\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":true,"formula":"prev(Count_4, 0) + if(Word = \"Pluto\", 1, 0)","guid":3107,"id":3107,"precision":2,"unit":null},{"name":"Count_5","type":"numeric","title":"Count 5","cid":"id:Miy2HdbUtDJDwuoE","description":"Running count of \"Mercury\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":true,"formula":"prev(Count_5, 0) + if(Word = \"Mercury\", 1, 0)","guid":3108,"id":3108,"precision":2,"unit":null},{"name":"Count_6","type":"numeric","title":"Count 6","cid":"id:MK-9jbvk6_iGQ5zt","description":"Running count of \"Venus\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":true,"formula":"prev(Count_6, 0) + if(Word = \"Venus\", 1, 0)","guid":3109,"id":3109,"precision":2,"unit":null},{"name":"Count_7","type":"numeric","title":"Count 7","cid":"id:OUy2y3JSY50B5Ic2","description":"Running count of \"Mars\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":true,"formula":"prev(Count_7, 0) + if(Word = \"Mars\", 1, 0)","guid":3110,"id":3110,"precision":2,"unit":null},{"name":"Count_8","type":"numeric","title":"Count 8","cid":"id:ccpAj8TEXbh1wYt4","description":"Running count of \"Jupiter\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":true,"formula":"prev(Count_8, 0) + if(Word = \"Jupiter\", 1, 0)","guid":3111,"id":3111,"precision":2,"unit":null},{"name":"MyCountBefore","type":"numeric","title":"MyCountBefore","cid":"id:SjzgczxuapXGKTr4","description":"Count of this word in previous draws","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":true,"formula":"if(Word = \"Uranus\", prev(Count_1, 0), if(Word = \"Neptune\", prev(Count_2, 0), if(Word = \"Saturn\", prev(Count_3, 0), if(Word = \"Pluto\", prev(Count_4, 0), if(Word = \"Mercury\", prev(Count_5, 0), if(Word = \"Venus\", prev(Count_6, 0), if(Word = \"Mars\", prev(Count_7, 0), prev(Count_8, 0))))))))","guid":3112,"id":3112,"precision":2,"unit":null},{"name":"DifferentBefore","type":"numeric","title":"DifferentBefore","cid":"id:y8MVAZYgy65aap4x","description":"Count of different words before this draw","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":true,"formula":"TotalBefore - MyCountBefore","guid":3113,"id":3113,"precision":2,"unit":null}],"cases":[],"caseName":null,"childAttrName":null,"collapseChildren":null,"guid":3090,"id":3090,"name":"Samples","title":"Sampled Words","type":"DG.Collection"}],"description":"","metadata":null,"preventReorg":false,"setAsideItems":[],"contextStorage":{"_links_":{"selectedCases":[]}}}],"globalValues":[{"name":"__samplerInstance","value":1,"guid":24}],"appName":"DG","appVersion":"2.0","appBuildNum":"0744","lang":"en","idCount":6164,"metadata":{"shared":{}}}