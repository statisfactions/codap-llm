eParentChildLinksConfigured":false,"attrs":[{"name":"Draw","type":"numeric","title":"Draw","cid":"id:YP23xTndaD26wMXS","description":"Draw number","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":false,"renameable":true,"deleteable":true,"guid":6134,"id":6134,"precision":2,"unit":null},{"name":"Word","type":"categorical","title":"Word","cid":"id:Z4oV50HlKVa2Yq7u","description":"The sampled word","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":false,"renameable":true,"deleteable":true,"guid":6135,"id":6135,"precision":2,"unit":null},{"name":"Pct_Uranus","type":"numeric","title":"% Uranus","cid":"id:taz3LVrvDvqUDGV9","description":"Running % of draws that were \"Uranus\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":false,"renameable":true,"deleteable":true,"formula":"if(DrawNumber > 0, round(100 * Count_1 / DrawNumber, 0), \"\")","guid":6136,"id":6136,"precision":2,"unit":null},{"name":"Pct_Neptune","type":"numeric","title":"% Neptune","cid":"id:qeKK9_WmIixBuUNd","description":"Running % of draws that were \"Neptune\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":false,"renameable":true,"deleteable":true,"formula":"if(DrawNumber > 0, round(100 * Count_2 / DrawNumber, 0), \"\")","guid":6137,"id":6137,"precision":2,"unit":null},{"name":"Pct_Saturn","type":"numeric","title":"% Saturn","cid":"id:u9GQ-jgzPTrCLM4i","description":"Running % of draws that were \"Saturn\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":false,"renameable":true,"deleteable":true,"formula":"if(DrawNumber > 0, round(100 * Count_3 / DrawNumber, 0), \"\")","guid":6138,"id":6138,"precision":2,"unit":null},{"name":"Pct_Pluto","type":"numeric","title":"% Pluto","cid":"id:O5ZfUF8LJCZlGh0E","description":"Running % of draws that were \"Pluto\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":false,"renameable":true,"deleteable":true,"formula":"if(DrawNumber > 0, round(100 * Count_4 / DrawNumber, 0), \"\")","guid":6139,"id":6139,"precision":2,"unit":null},{"name":"Pct_Mercury","type":"numeric","title":"% Mercury","cid":"id:nAY62oQQWK3bqEBV","description":"Running % of draws that were \"Mercury\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":false,"renameable":true,"deleteable":true,"formula":"if(DrawNumber > 0, round(100 * Count_5 / DrawNumber, 0), \"\")","guid":6140,"id":6140,"precision":2,"unit":null},{"name":"Pct_Venus","type":"numeric","title":"% Venus","cid":"id:6WqKwkhOW_zuhoCX","description":"Running % of draws that were \"Venus\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":false,"renameable":true,"deleteable":true,"formula":"if(DrawNumber > 0, round(100 * Count_6 / DrawNumber, 0), \"\")","guid":6141,"id":6141,"precision":2,"unit":null},{"name":"Pct_Mars","type":"numeric","title":"% Mars","cid":"id:UeDGugh2kOJkt0vd","description":"Running % of draws that were \"Mars\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":false,"renameable":true,"deleteable":true,"formula":"if(DrawNumber > 0, round(100 * Count_7 / DrawNumber, 0), \"\")","guid":6142,"id":6142,"precision":2,"unit":null},{"name":"Pct_Jupiter","type":"numeric","title":"% Jupiter","cid":"id:zpFHmqY1DfRSW29H","description":"Running % of draws that were \"Jupiter\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":false,"renameable":true,"deleteable":true,"formula":"if(DrawNumber > 0, round(100 * Count_8 / DrawNumber, 0), \"\")","guid":6143,"id":6143,"precision":2,"unit":null},{"name":"Differentness","type":"numeric","title":"Differentness (%)","cid":"id:19YfAIvqawx4OU1q","description":"What % of previous draws were different from this word?","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":false,"renameable":true,"deleteable":true,"formula":"if(TotalBefore > 0, round(100 * DifferentBefore / TotalBefore, 0), \"\")","guid":6144,"id":6144,"precision":2,"unit":null},{"name":"DrawNumber","type":"numeric","title":"DrawNumber","cid":"id:cnN7_gsxB5yoAfxc","description":"Sequential draw number","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":true,"formula":"prev(DrawNumber, 0) + 1","guid":6145,"id":6145,"precision":2,"unit":null},{"name":"TotalBefore","type":"numeric","title":"TotalBefore","cid":"id:xFX7d0GgryCUbmxi","description":"Total draws before this one","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":true,"formula":"DrawNumber - 1","guid":6146,"id":6146,"precision":2,"unit":null},{"name":"Count_1","type":"numeric","title":"Count 1","cid":"id:-C3fobef5fiIDufN","description":"Running count of \"Uranus\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":true,"formula":"prev(Count_1, 0) + if(Word = \"Uranus\", 1, 0)","guid":6147,"id":6147,"precision":2,"unit":null},{"name":"Count_2","type":"numeric","title":"Count 2","cid":"id:BKdImuMWLL5yPkJC","description":"Running count of \"Neptune\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":true,"formula":"prev(Count_2, 0) + if(Word = \"Neptune\", 1, 0)","guid":6148,"id":6148,"precision":2,"unit":null},{"name":"Count_3","type":"numeric","title":"Count 3","cid":"id:kSNLAyapOwlAtbuJ","description":"Running count of \"Saturn\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":true,"formula":"prev(Count_3, 0) + if(Word = \"Saturn\", 1, 0)","guid":6149,"id":6149,"precision":2,"unit":null},{"name":"Count_4","type":"numeric","title":"Count 4","cid":"id:C6q6hbtzomJ72X21","description":"Running count of \"Pluto\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":true,"formula":"prev(Count_4, 0) + if(Word = \"Pluto\", 1, 0)","guid":6150,"id":6150,"precision":2,"unit":null},{"name":"Count_5","type":"numeric","title":"Count 5","cid":"id:abJVACexAjSNrZDY","description":"Running count