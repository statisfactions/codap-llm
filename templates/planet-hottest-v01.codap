mber > 0, round(100 * Count_3 / DrawNumber, 0), \"\")","guid":1044,"id":1044,"precision":2,"unit":null},{"name":"Pct_Jupiter","type":"numeric","title":"% Jupiter","cid":"id:er6VJK5qqR-IhRO_","description":"Running % of draws that were \"Jupiter\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":false,"renameable":true,"deleteable":true,"formula":"if(DrawNumber > 0, round(100 * Count_4 / DrawNumber, 0), \"\")","guid":1045,"id":1045,"precision":2,"unit":null},{"name":"Pct_eos","type":"numeric","title":"% <eos","cid":"id:TzAjYJfz4Bmw4fJF","description":"Running % of draws that were \"<eos\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":false,"renameable":true,"deleteable":true,"formula":"if(DrawNumber > 0, round(100 * Count_5 / DrawNumber, 0), \"\")","guid":1046,"id":1046,"precision":2,"unit":null},{"name":"Pct_Venues","type":"numeric","title":"% Venues","cid":"id:QBSVwkFH4Sv7OHUb","description":"Running % of draws that were \"Venues\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":false,"renameable":true,"deleteable":true,"formula":"if(DrawNumber > 0, round(100 * Count_6 / DrawNumber, 0), \"\")","guid":1047,"id":1047,"precision":2,"unit":null},{"name":"Pct_Saturn","type":"numeric","title":"% Saturn","cid":"id:pwx8jAwuSpuwxbEU","description":"Running % of draws that were \"Saturn\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":false,"renameable":true,"deleteable":true,"formula":"if(DrawNumber > 0, round(100 * Count_7 / DrawNumber, 0), \"\")","guid":1048,"id":1048,"precision":2,"unit":null},{"name":"Pct_Sun","type":"numeric","title":"% Sun","cid":"id:cWMsWA2Fy39yVHAo","description":"Running % of draws that were \"Sun\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":false,"renameable":true,"deleteable":true,"formula":"if(DrawNumber > 0, round(100 * Count_8 / DrawNumber, 0), \"\")","guid":1049,"id":1049,"precision":2,"unit":null},{"name":"Differentness","type":"numeric","title":"Differentness (%)","cid":"id:qYq0dsQ2HlSj24X2","description":"What % of previous draws were different from this word?","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":false,"renameable":true,"deleteable":true,"formula":"if(TotalBefore > 0, round(100 * DifferentBefore / TotalBefore, 0), \"\")","guid":1050,"id":1050,"precision":2,"unit":null},{"name":"DrawNumber","type":"numeric","title":"DrawNumber","cid":"id:SBrx9--poR0NUolO","description":"Sequential draw number","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":true,"formula":"prev(DrawNumber, 0) + 1","guid":1051,"id":1051,"precision":2,"unit":null},{"name":"TotalBefore","type":"numeric","title":"TotalBefore","cid":"id:ZRb4_XoRONQB2jva","description":"Total draws before this one","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":true,"formula":"DrawNumber - 1","guid":1052,"id":1052,"precision":2,"unit":null},{"name":"Count_1","type":"numeric","title":"Count 1","cid":"id:9evmCj32RTmwM-UO","description":"Running count of \"Venus\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":true,"formula":"prev(Count_1, 0) + if(Word = \"Venus\", 1, 0)","guid":1053,"id":1053,"precision":2,"unit":null},{"name":"Count_2","type":"numeric","title":"Count 2","cid":"id:uETsuC8ww7tVoh-h","description":"Running count of \"Mercury\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":true,"formula":"prev(Count_2, 0) + if(Word = \"Mercury\", 1, 0)","guid":1054,"id":1054,"precision":2,"unit":null},{"name":"Count_3","type":"numeric","title":"Count 3","cid":"id:9Piru-tgk005BJV-","description":"Running count of \"Mars\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":true,"formula":"prev(Count_3, 0) + if(Word = \"Mars\", 1, 0)","guid":1055,"id":1055,"precision":2,"unit":null},{"name":"Count_4","type":"numeric","title":"Count 4","cid":"id:94EikRLRW5K0r-j1","description":"Running count of \"Jupiter\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":true,"formula":"prev(Count_4, 0) + if(Word = \"Jupiter\", 1, 0)","guid":1056,"id":1056,"precision":2,"unit":null},{"name":"Count_5","type":"numeric","title":"Count 5","cid":"id:5KsJ4KYWraajfnNM","description":"Running count of \"<eos\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":true,"formula":"prev(Count_5, 0) + if(Word = \"<eos\", 1, 0)","guid":1057,"id":1057,"precision":2,"unit":null},{"name":"Count_6","type":"numeric","title":"Count 6","cid":"id:h1gtiJTJ7xesfYu4","description":"Running count of \"Venues\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":true,"formula":"prev(Count_6, 0) + if(Word = \"Venues\", 1, 0)","guid":1058,"id":1058,"precision":2,"unit":null},{"name":"Count_7","type":"numeric","title":"Count 7","cid":"id:zDkGJiahoCqSghNc","description":"Running count of \"Saturn\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":true,"formula":"prev(Count_7, 0) + if(Word = \"Saturn\", 1, 0)","guid":1059,"id":1059,"precision":2,"unit":null},{"name":"Count_8","type":"numeric","title":"Count 8","cid":"id:gi98lt7FDj1G_fFi","description":"Running count of \"Sun\"","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":true,"formula":"prev(Count_8, 0) + if(Word = \"Sun\", 1, 0)","guid":1060,"id":1060,"precision":2,"unit":null},{"name":"MyCountBefore","type":"numeric","title":"MyCountBefore","cid":"id:yecp-UqrvyqZRjc9","description":"Count of this word in previous draws","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":true,"formula":"if(Word = \"Venus\", prev(Count_1, 0), if(Word = \"Mercury\", prev(Count_2, 0), if(Word = \"Mars\", prev(Count_3, 0), if(Word = \"Jupiter\", prev(Count_4, 0), if(Word = \"<eos\", prev(Count_5, 0), if(Word = \"Venues\", prev(Count_6, 0), if(Word = \"Saturn\", prev(Count_7, 0), prev(Count_8, 0))))))))","guid":1061,"id":1061,"precision":2,"unit":null},{"name":"DifferentBefore","type":"numeric","title":"DifferentBefore","cid":"id:v4VMcvGCSJE0r8Sc","description":"Count of different words before this draw","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":true,"formula":"TotalBefore - MyCountBefore","guid":1062,"id":1062,"precision":2,"unit":null}],"cases":[],"caseName":null,"childAttrName":null,"collapseChildren":null,"guid":1039,"id":1039,"name":"Samples","title":"Sampled Words","type":"DG.Collection"}],"description":"","metadata":null,"preventReorg":false,"setAsideItems":[],"contextStorage":{"_links_":{"selectedCases":[]}}}],"globalValues":[{"name":"__samplerInstance","value":1,"guid":24}],"appName":"DG","appVersion":"2.0","appBuildNum":"0744","lang":"en","idCount":3100,"metadata":{"shared":{}}}